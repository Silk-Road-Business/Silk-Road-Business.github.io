  "route": "/fact-checking/",
  "title": "\u4E8B\u5B9E\u6838\u67E5",
  "summary": "\u8BF4\u660E\u4E1D\u8DEF\u5546\u8BAF\u5728\u53D1\u5E03\u6587\u7AE0\u548C\u4F01\u4E1A\u8D44\u6599\u524D\u5982\u4F55\u6838\u5BF9\u4E8B\u5B9E\u3001\u6765\u6E90\u4E0E\u65F6\u95F4\u4FE1\u606F\u3002",
  "body": "\u003Ch2\u003E\u6838\u67E5\u5BF9\u8C61\u003C/h2\u003E\n\u003Cp\u003E\u6838\u67E5\u91CD\u70B9\u5305\u62EC\u4F01\u4E1A\u540D\u79F0\u3001\u56FD\u5BB6\u6216\u5730\u533A\u3001\u884C\u4E1A\u3001\u4E1A\u52A1\u80FD\u529B\u3001\u6765\u6E90\u94FE\u63A5\u3001\u53D1\u5E03\u65E5\u671F\u3001\u5BA1\u6838\u65E5\u671F\u3001\u4F01\u4E1A\u8D44\u6599\u6838\u9A8C\u65E5\u671F\uFF0C\u4EE5\u53CA\u4F1A\u5F71\u54CD\u7528\u6237\u5224\u65AD\u7684\u5173\u952E\u4E8B\u5B9E\u3002\u003C/p\u003E\n\u003Ch2\u003E\u6838\u67E5\u65B9\u5F0F\u003C/h2\u003E\n\u003Cp\u003E\u7F16\u8F91\u6D41\u7A0B\u4F1A\u4F18\u5148\u67E5\u770B\u539F\u59CB\u6765\u6E90\u548C\u516C\u5F00\u8BB0\u5F55\uFF1B\u4F01\u4E1A\u8D44\u6599\u4F1A\u7ED3\u5408\u4F01\u4E1A\u63D0\u4EA4\u4FE1\u606F\u3001\u516C\u5F00\u7F51\u9875\u548C\u7F16\u8F91\u6838\u9A8C\u8BB0\u5F55\u5904\u7406\u3002\u65E0\u6CD5\u786E\u8BA4\u7684\u5185\u5BB9\u5E94\u964D\u7EA7\u8868\u8FF0\u3001\u4FDD\u7559\u6765\u6E90\u8BF4\u660E\uFF0C\u6216\u4E0D\u53D1\u5E03\u3002\u003C/p\u003E\n\u003Ch2\u003E\u65F6\u95F4\u5B57\u6BB5\u003C/h2\u003E\n\u003Cp\u003E\u6587\u7AE0\u7684\u5BA1\u6838\u65E5\u671F\u5E94\u6765\u81EA\u660E\u786E\u7684 ReviewedAt \u5B57\u6BB5\uFF0C\u4F01\u4E1A\u8D44\u6599\u7684\u6838\u9A8C\u65E5\u671F\u5E94\u6765\u81EA VerifiedAt \u5B57\u6BB5\uFF1B\u4E0D\u5F97\u628A\u5185\u5BB9\u6E90\u7684\u6700\u540E\u7F16\u8F91\u65F6\u95F4\u5F53\u4F5C\u4E1A\u52A1\u5BA1\u6838\u6216\u6838\u9A8C\u65E5\u671F\u3002\u003C/p\u003E\n",
